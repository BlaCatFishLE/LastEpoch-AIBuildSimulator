    "conditions": [
      "none"
    ],
    "notes": "把场景 states/effects（固定条件估算）求值成「已满足/未满足/未知」，并只对已映射的效果生成重算提案；不模拟获得/维持状态的操作成本。当前仅 BH 案例接入（FR 仍是 hit_buffs 独立筛查）。"
  },
  "rule_ref": {
    "kind": "none",
    "ref": "条件求值语义由注册表 effects[].conditions/control 与场景契约定义，没有单条规则 ID；注册表 tools/phase3/rules/conditional-effects-bh-stage1-v1.json 是权威源。"
  },
  "parameter_bindings": [
    {
      "parameter": "scenario states",
      "source": "current:matched_instances",
      "note": "条件状态声明（目标/玩家/派生 auto.*）；由 registry.shared_states 定义默认与边界。"
    },
    {
      "parameter": "scenario effects",
      "source": "current:matched_instances",
      "note": "逐效果 enabled/stacks；由 registry.effects[].control 定义控制类型。"
    },
    {
      "parameter": "baseline_profile",
      "source": "current:matched_instances",
      "note": "legacy_single_skill / build_base 两个基线口径之一。"
    }
  ],
  "handler_ref": {
    "module": "le_calc.conditional.evaluate",
    "symbol": "evaluate_scenario",
    "note": "求值主入口：evaluate_effect/condition_results/_modifier_results；场景规范化在 le_calc.conditional.scenario.normalize_scenario/validate_scenario；重算在 le_calc.conditional.recompute.recompute_scenario。"
  },
