{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "le-dps-result-v6",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "applications",
    "applications_ledger",
    "assumptions",
    "components",
    "coverage",
    "evaluations",
    "execution_fingerprint",
    "issues",
    "plan_sha256",
    "policy_results",
    "presentation",
    "primary_evaluation",
    "scenario",
    "scenario_sha256",
    "schema",
    "subject",
    "target_side",
    "totals",
    "version",
    "windows"
  ],
  "properties": {
    "schema": {
      "const": "le-dps-result-v6"
    },
    "version": {
      "const": "6.0.0"
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "plan_ref": {
      "type": "object"
    },
    "subject": {
      "type": "object"
    },
    "scenario": {
      "type": "object"
    },
    "primary_evaluation": {
      "type": "string"
    },
    "evaluations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "evaluation_id",
          "primary",
          "policy_id",
          "horizon_damage",
          "horizon_dps",
          "cast_count",
          "max_concurrent",
          "window_count"
        ]
      }
    },
    "primary_policy_id": {
      "type": "string"
    },
    "target_side": {
      "type": "object"
    },
    "presentation": {
      "type": "object"
    },
    "capabilities": {
      "type": "array"
    },
    "policy_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "policy_id",
          "condition",
          "primary",
          "casts",
          "windows",
          "totals"
        ]
      }
    },
    "windows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "window_s",
          "hit_damage",
          "dot_damage",
          "application_damage",
          "total_damage",
          "dps",
          "cast_count",
          "unsettled_tail_damage"
        ]
      }
    },
    "totals": {
      "type": "object",
      "required": [
        "horizon_damage",
        "horizon_dps",
        "hit_damage",
        "dot_damage",
        "application_damage",
        "unsettled_tail_damage",
        "cast_count",
        "max_concurrent"
      ]
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "component_id",
          "kind",
          "damage_type",
          "damage_total"
        ]
      }
    },
    "applications": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "application_id",
          "ailment_id",
          "damage_type",
          "damage_total",
          "cohorts"
        ]
      }
    },
    "application_units": {
      "type": "array"
    },
    "applications_ledger": {
      "type": "array",
      "minItems": 1
    },
    "contribution_application_summary": {
      "type": "object"
    },
    "coverage": {
      "type": "object",
      "required": [
        "status",
        "gap_count",
        "gaps"
      ],
      "properties": {
        "status": {
          "enum": [
            "complete",
            "partial"
          ]
        },
        "gap_count": {
          "type": "integer"
        },
        "gaps": {
          "type": "array"
        }
      }
    },
    "issues": {
      "type": "array"
    },
    "limitations": {
      "type": "array"
    },
    "consistency": {
      "type": "object"
    },
    "implementation_fingerprints": {
      "type": "object"
    },
    "scenario_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "execution_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "assumptions": {
      "type": "array"
    },
    "contributions": {
      "type": "array"
    },
    "effect_ledger": {
      "type": "object"
    },
    "frequency": {
      "type": "object"
    },
    "actors": {
      "type": "array"
    },
    "actor_units": {
      "type": "array"
    }
  }
}
