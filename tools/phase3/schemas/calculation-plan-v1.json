{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "le-calculation/calculation-plan-v1.json",
  "title": "统一计算计划 v1（le-calculation-plan-v1）",
  "description": "编译器产出的可序列化、可独立执行的计算契约。执行器只读取顶层 components、parameters.skill 基础参数、schedule.every_nth_hit 等权威字段；计划内不得出现镜像字段。来源、所有权键、固定阶段/依赖与覆盖裁决记录均参与校验。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "plan_id",
    "plan_sha256",
    "subject",
    "compiler",
    "executor_requirements",
    "input_refs",
    "sources",
    "facts",
    "parameters",
    "controls",
    "conditions",
    "components",
    "effects",
    "evaluation",
    "schedule",
    "diagnostics",
    "assumptions",
    "scope",
    "presentation"
  ],
  "properties": {
    "schema": {
      "const": "le-calculation-plan-v1"
    },
    "plan_id": {
      "type": "string",
      "pattern": "^cp-[0-9a-f]{64}$"
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "build_id",
        "revision_id",
        "main_ability_id"
      ],
      "properties": {
        "case_id": {
          "type": "string"
        },
        "build_id": {
          "type": "string"
        },
        "revision_id": {
          "type": "string"
        },
        "main_ability_id": {
          "type": "string"
        }
      }
    },
    "compiler": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "origin",
        "implementation_fingerprint",
        "fingerprint"
      ],
      "properties": {
        "version": {
          "type": "string"
        },
        "origin": {
          "enum": [
            "profile_v2",
            "native_template"
          ]
        },
        "implementation_fingerprint": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "executor_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "handlers",
        "executor_fingerprint"
      ],
      "properties": {
        "handlers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "handler_id",
              "version"
            ],
            "properties": {
              "handler_id": {
                "type": "string"
              },
              "version": {
                "type": "string"
              }
            }
          }
        },
        "executor_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "input_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "path",
          "sha256"
        ],
        "properties": {
          "role": {
            "enum": [
              "case",
              "profile",
              "profile_content",
              "calculation_input",
              "build_spec",
              "dataset_pointer",
              "dataset_content",
              "attribute_conversion_rules",
              "compiler_source",
              "template",
              "mechanism_library",
              "rule_file"
            ]
          },
          "path": {
            "type": [
              "string",
              "null"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "kind",
          "identity",
          "semantics",
          "binding_status",
          "evidence"
        ],
        "properties": {
          "source_id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "base_character",
              "effect",
              "item_mod",
              "passive_node",
              "rule_source",
              "skill_node",
              "state_source",
              "template_constant"
            ]
          },
          "identity": {
            "type": "object"
          },
          "semantics": {
            "type": "object"
          },
          "binding_status": {
            "type": "string"
          },
          "evidence": {
            "type": "array"
          }
        }
      }
    },
    "facts": {
      "type": "object"
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skill",
        "crit",
        "ailments",
        "additional_chance",
        "damage_to_penetration",
        "cooldown_reduction"
      ],
      "properties": {
        "skill": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "base_damage",
            "added_damage_scaling",
            "crit_chance",
            "crit_multiplier",
            "cooldown_s",
            "action_s",
            "skill_name"
          ],
          "properties": {
            "base_damage": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": "number",
                "minimum": 0
              }
            },
            "added_damage_scaling": {
              "type": "number",
              "minimum": 0
            },
            "crit_chance": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "crit_multiplier": {
              "type": "number",
              "minimum": 0
            },
            "cooldown_s": {
              "type": "number",
              "minimum": 0
            },
            "action_s": {
              "type": "number",
              "minimum": 0
            },
            "skill_name": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "crit": {
          "type": "object"
        },
        "ailments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "name",
              "damage_type",
              "duration_s",
              "base_damage"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "damage_type": {
                "enum": [
                  "Physical",
                  "Fire",
                  "Cold",
                  "Lightning",
                  "Void",
                  "Poison",
                  "Necrotic"
                ]
              },
              "duration_s": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "base_damage": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        },
        "additional_chance": {
          "type": "object"
        },
        "damage_to_penetration": {
          "type": [
            "object",
            "null"
          ]
        },
        "cooldown_reduction": {
          "type": "number"
        },
        "attribute_ratios": {
          "type": "object"
        },
        "attribute_conversion": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    },
    "controls": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "control_id",
          "namespace",
          "key",
          "type",
          "default"
        ],
        "properties": {
          "control_id": {
            "type": "string"
          },
          "namespace": {
            "enum": [
              "state",
              "target"
            ]
          },
          "key": {
            "type": "string"
          },
          "label": {
            "type": [
              "string",
              "null"
            ]
          },
          "source": {
            "type": [
              "string",
              "null"
            ]
          },
          "type": {
            "enum": [
              "boolean",
              "integer",
              "number"
            ]
          },
          "default": {
            "type": [
              "boolean",
              "integer",
              "number",
              "null"
            ]
          },
          "min": {
            "type": [
              "integer",
              "number",
              "null"
            ]
          },
          "max": {
            "type": [
              "integer",
              "number",
              "null"
            ]
          },
          "readonly": {
            "type": "boolean"
          },
          "effect": {
            "type": [
              "string",
              "null"
            ]
          },
          "requires_target": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "condition_id",
          "op",
          "terms"
        ],
        "properties": {
          "condition_id": {
            "type": "string"
          },
          "op": {
            "enum": [
              "always",
              "all",
              "any"
            ]
          },
          "terms": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "control_true",
                    "control_equals",
                    "control_count",
                    "target_true",
                    "code"
                  ]
                },
                "key": {
                  "type": "string"
                },
                "value": {
                  "type": [
                    "boolean",
                    "integer",
                    "number",
                    "string",
                    "null"
                  ]
                },
                "code": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "components": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "component_id",
          "kind",
          "tags",
          "crit_capable"
        ],
        "properties": {
          "component_id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "hit",
              "dot"
            ]
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "crit_capable": {
            "type": "boolean"
          },
          "adaptive_damage_type": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "maxItems": 2,
      "description": "执行器唯一读取的组件权威定义（恰好一个 hit 与一个 dot）；命中周期与 Buff 条件不在组件里重复声明。"
    },
    "effects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "effect_id",
          "category",
          "stage",
          "handler_id",
          "handler_version",
          "stat_key",
          "operation",
          "unit",
          "included_static",
          "required",
          "emits_contribution",
          "value_mode",
          "value_params",
          "source_refs",
          "ownership_key",
          "support_status"
        ],
        "properties": {
          "effect_id": {
            "type": "string",
            "minLength": 1
          },
          "contribution_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "rule_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "sequence": {
            "type": "integer",
            "minimum": 0
          },
          "label": {
            "type": [
              "string",
              "null"
            ]
          },
          "category": {
            "enum": [
              "base",
              "mod",
              "passive",
              "node_binding",
              "attribute_conversion",
              "attribute_scaling",
              "effect",
              "state_scaling",
              "movement_conversion",
              "cooldown_reduction"
            ]
          },
          "stage": {
            "enum": [
              "baseline",
              "pre_attribute",
              "pre_attribute_effects",
              "attribute_conversion",
              "attribute_scaling",
              "derived_pools",
              "damage_components",
              "frequency",
              "projection"
            ]
          },
          "handler_id": {
            "type": "string",
            "minLength": 1
          },
          "handler_version": {
            "type": "string",
            "minLength": 1
          },
          "source_kind": {
            "type": "string"
          },
          "source_label": {
            "type": "string"
          },
          "source_path": {
            "type": "string"
          },
          "stat_key": {
            "type": "string"
          },
          "stat_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "operation": {
            "enum": [
              "added",
              "increased",
              "more",
              "base",
              "flag"
            ]
          },
          "value": {
            "type": "number"
          },
          "unit": {
            "enum": [
              "flat",
              "percent",
              "seconds",
              "flag"
            ]
          },
          "damage_tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "target": {
            "type": [
              "string",
              "integer",
              "null"
            ]
          },
          "group": {
            "type": [
              "string",
              "null"
            ]
          },
          "value_source": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          },
          "included_static": {
            "type": "boolean"
          },
          "condition_status_static": {
            "type": "string"
          },
          "exclusion_reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "condition_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "condition_code": {
            "type": [
              "string",
              "null"
            ]
          },
          "condition_code_static": {
            "type": "boolean"
          },
          "condition_style": {
            "type": [
              "object",
              "null"
            ]
          },
          "coverage_class": {
            "type": [
              "string",
              "null"
            ]
          },
          "coverage_status": {
            "type": [
              "string",
              "null"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "emits_contribution": {
            "type": "boolean"
          },
          "support_status": {
            "type": "string"
          },
          "value_mode": {
            "enum": [
              "static",
              "condition",
              "condition_code",
              "state_count",
              "stack_scale",
              "movement_conversion"
            ]
          },
          "value_params": {
            "type": "object"
          },
          "ledger_kind": {
            "type": [
              "string",
              "null"
            ]
          },
          "ledger": {
            "type": [
              "object",
              "null"
            ]
          },
          "owner": {
            "type": [
              "object",
              "null"
            ]
          },
          "source_facts": {
            "type": "object"
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ownership_key": {
            "type": [
              "object",
              "null"
            ]
          },
          "raw": {
            "type": [
              "object",
              "null"
            ]
          },
          "evidence": {
            "type": "array"
          }
        }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage_order",
        "effect_stage",
        "dependencies",
        "ownership"
      ],
      "properties": {
        "stage_order": {
          "const": [
            "baseline",
            "pre_attribute",
            "pre_attribute_effects",
            "attribute_conversion",
            "attribute_scaling",
            "derived_pools",
            "damage_components",
            "frequency",
            "projection"
          ]
        },
        "effect_stage": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "baseline",
              "pre_attribute",
              "pre_attribute_effects",
              "attribute_conversion",
              "attribute_scaling",
              "derived_pools",
              "damage_components",
              "frequency",
              "projection"
            ]
          }
        },
        "dependencies": {
          "const": [
            {
              "from": "baseline",
              "to": "pre_attribute"
            },
            {
              "from": "pre_attribute",
              "to": "pre_attribute_effects"
            },
            {
              "from": "pre_attribute_effects",
              "to": "attribute_conversion"
            },
            {
              "from": "attribute_conversion",
              "to": "attribute_scaling"
            },
            {
              "from": "attribute_scaling",
              "to": "derived_pools"
            },
            {
              "from": "derived_pools",
              "to": "damage_components"
            },
            {
              "from": "damage_components",
              "to": "frequency"
            },
            {
              "from": "frequency",
              "to": "projection"
            }
          ]
        },
        "ownership": {
          "const": "unique_by_ownership_key"
        }
      }
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "driver",
        "interval_policy",
        "first_cast_s",
        "windows_s",
        "every_nth_hit"
      ],
      "properties": {
        "driver": {
          "const": "fixed_repeat"
        },
        "interval_policy": {
          "const": "max(action_time, cooldown)"
        },
        "first_cast_s": {
          "type": "number",
          "minimum": 0
        },
        "windows_s": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "every_nth_hit": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "n",
            "extra_more",
            "counting",
            "phase"
          ],
          "properties": {
            "n": {
              "type": "integer",
              "minimum": 1
            },
            "extra_more": {
              "type": "number",
              "minimum": 0
            },
            "counting": {
              "const": "hit"
            },
            "phase": {
              "const": "from_first_hit"
            }
          }
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "message",
          "severity",
          "affects_coverage"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "info",
              "warning",
              "error"
            ]
          },
          "related_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "affects_coverage": {
            "type": "boolean"
          },
          "count": {
            "type": "integer",
            "minimum": 1
          },
          "impact": {
            "type": "string"
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "assumption_id",
          "status",
          "note"
        ],
        "properties": {
          "assumption_id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "scope": {
      "type": "object",
      "required": [
        "skill",
        "ailment_labels",
        "limitations"
      ],
      "properties": {
        "skill": {
          "type": "string"
        },
        "ailment_labels": {
          "type": "array"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "presentation": {
      "type": "object",
      "required": [
        "skill_name",
        "skill_names",
        "character",
        "equipment",
        "controls"
      ],
      "properties": {
        "skill_name": {
          "type": "string"
        },
        "skill_names": {
          "type": "object"
        },
        "character": {
          "type": [
            "object",
            "null"
          ]
        },
        "equipment": {
          "type": "array"
        },
        "controls": {
          "type": "array"
        }
      }
    }
  }
}
