{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "le-calc/report-capabilities-v1.json",
  "title": "Report capabilities artifact v1 (report-capabilities-v1)",
  "description": "Runtime companion artifact written next to the player report (reports/<case>/<run>/report-capabilities.json, workflow-interface §10.1/§10.4). Carries the per-model capability document consumed by the shared renderer and the recompute service (no JS hardcoded controls), the report-cache-relevant renderer fingerprint, and repository-relative acceptance references (HTML-01..12 / LIVE-01..08 and the case expected baseline).",
  "type": "object",
  "required": [
    "schema_version",
    "case_id",
    "model_id",
    "ui_contract_version",
    "renderer_fingerprint",
    "capabilities_digest",
    "capabilities",
    "acceptance_refs"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "report-capabilities-v1"
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "model_id": {
      "type": "string",
      "enum": [
        "black-hole",
        "hit"
      ]
    },
    "skill_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "run_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "report_path": {
      "type": [
        "string",
        "null"
      ],
      "description": "仓库根相对路径（禁止机器绝对路径）"
    },
    "ui_contract_version": {
      "const": "le-player-report-ui-v1"
    },
    "renderer_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "report_ui/** + report.py/hit_report.py/html.py 源码与 assets 的 sha256；渲染器改动使报告缓存失效"
    },
    "capabilities_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "capabilities": {
      "type": "object",
      "required": [
        "schema_version",
        "model_id",
        "skill_id",
        "ui_contract_version",
        "pages",
        "target_fields",
        "buff_controls",
        "windows",
        "modes",
        "recalculation",
        "informational"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "le-model-capabilities-v1"
        },
        "model_id": {
          "type": "string",
          "enum": [
            "black-hole",
            "hit"
          ]
        },
        "skill_id": {
          "type": "string",
          "minLength": 1
        },
        "ui_contract_version": {
          "const": "le-player-report-ui-v1"
        },
        "pages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "kind"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "generic",
                  "model"
                ]
              }
            },
            "additionalProperties": true
          }
        },
        "target_fields": {
          "type": "array",
          "description": "目标面板可编辑字段与范围；服务端按此严格校验请求 target",
          "items": {
            "type": "object",
            "required": [
              "field",
              "kind"
            ],
            "properties": {
              "field": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "enum": [
                  "int",
                  "integer",
                  "float",
                  "number",
                  "bool",
                  "boolean",
                  "stacks",
                  "string",
                  "enum"
                ]
              },
              "min": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "max": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "default": {},
              "unit": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        },
        "buff_controls": {
          "type": "array",
          "description": "Buff/状态卡控件声明；服务端按此校验 states（未知 state/层数越界明确拒绝）",
          "items": {
            "type": "object",
            "required": [
              "state_key",
              "kind"
            ],
            "properties": {
              "state_key": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "enum": [
                  "toggle",
                  "stacks",
                  "cast_state"
                ]
              },
              "min": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "max": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "default": {},
              "readonly": {
                "type": "boolean"
              },
              "label": {
                "type": "string"
              },
              "source": {
                "type": "string"
              },
              "effect_id": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        },
        "windows": {
          "type": "array",
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "description": "支持的聚合窗口（秒）；空数组表示该模型无窗口聚合"
        },
        "modes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "支持的模式/策略 id（如 eager/patient、cooldown_limited/attack_speed_limited）"
        },
        "baseline_profiles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "model_parameters": {
          "type": "array",
          "description": "模型参数覆盖声明（如 FR 每次施放命中数与权重）",
          "items": {
            "type": "object",
            "required": [
              "key",
              "kind"
            ],
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "enum": [
                  "int",
                  "integer",
                  "float",
                  "number",
                  "bool",
                  "stacks",
                  "list"
                ]
              },
              "min": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "max": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "default": {},
              "unit": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "aliases": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": true
          }
        },
        "scenario_fields": {
          "type": "object",
          "required": [
            "required",
            "allowed"
          ],
          "properties": {
            "required": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "allowed": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "legacy_scenario_fields": {
          "type": "object",
          "description": "当前报告 JS 仍会提交的旧格式场景字段及其严格校验类型",
          "additionalProperties": {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "object",
                  "string",
                  "effect_map",
                  "hit_override"
                ]
              }
            },
            "additionalProperties": true
          }
        },
        "recalculation": {
          "type": "object",
          "required": [
            "supported",
            "request_kind",
            "response_kind",
            "capabilities_version",
            "binding_checks"
          ],
          "properties": {
            "supported": {
              "type": "boolean"
            },
            "request_kind": {
              "const": "le-recalc-request-v1"
            },
            "response_kind": {
              "const": "le-recalc-response-v1"
            },
            "capabilities_version": {
              "type": "string",
              "minLength": 1
            },
            "binding_checks": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "commands": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "prepare",
                  "compute",
                  "recompute"
                ]
              }
            },
            "bindings_kind": {
              "const": "le-recalc-bindings-v1"
            },
            "report_config_schema": {
              "const": "le-report-config-v1"
            },
            "session_scoped_revisions": {
              "type": "boolean"
            },
            "client_session": {
              "type": "object",
              "required": [
                "field",
                "required",
                "pattern",
                "legacy_policy"
              ],
              "properties": {
                "field": {
                  "const": "client_session_id"
                },
                "required": {
                  "type": "boolean"
                },
                "pattern": {
                  "type": "string"
                },
                "generation": {
                  "type": "string"
                },
                "legacy_policy": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        },
        "informational": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "message"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        },
        "profile_states": {
          "type": "object",
          "description": "baseline profile -> states 映射；页面切预设时据此更新控件（服务端按 profile.states 计算双基线）",
          "additionalProperties": {
            "type": "object"
          }
        },
        "renderer_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "与 report-capabilities.json 顶层/页面 meta/缓存键同源的唯一渲染器指纹（D1）"
        },
        "hit_policy": {
          "type": "object",
          "description": "F1 命中权重政策：hit 模型 kind=first_full_then_fraction（第1击 1.0、后续 0.5，hits min/max/default，custom_weights_supported）；BH 为 not_applicable。页面/客户端据此恢复 4→1→4 的默认权重，仅显式 damage_weights 作为覆盖。",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "not_applicable",
                "first_full_then_fraction"
              ]
            },
            "first_weight": {
              "type": "number"
            },
            "subsequent_weight": {
              "type": "number"
            },
            "hits": {
              "type": "object",
              "required": [
                "min",
                "max",
                "default"
              ],
              "properties": {
                "min": {
                  "type": "integer",
                  "minimum": 1
                },
                "max": {
                  "type": "integer",
                  "minimum": 1
                },
                "default": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "additionalProperties": false
            },
            "custom_weights_supported": {
              "type": "boolean"
            },
            "semantics": {
              "type": "string"
            }
          },
          "additionalProperties": true
        }
      }
    },
    "acceptance_refs": {
      "type": "array",
      "minItems": 1,
      "description": "仓库相对路径；指向 HTML-01..12/LIVE-01..08 验收矩阵与案例 expected",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "path"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "contract",
              "acceptance_matrix",
              "audit",
              "case_expected",
              "model"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "locator": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "cache": {
      "type": "object",
      "description": "3-A 缓存边界：数值缓存键不含端口，报告缓存键含端点/端口与 UI/渲染器指纹",
      "required": [
        "numeric_key",
        "report_key",
        "recompute_endpoint"
      ],
      "properties": {
        "numeric_key": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "report_key": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "recompute_endpoint": {
          "type": "string",
          "pattern": "^http://(127\\.0\\.0\\.1|localhost|\\[::1\\]):[0-9]{1,5}/recompute$"
        },
        "ui_contract_version": {
          "type": "string"
        },
        "renderer_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "generated_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "bindings": {
      "type": "object",
      "description": "嵌入页面的 le-recalc-bindings-v1 数据（与服务端 binding 一致）",
      "required": [
        "schema_version",
        "case_id",
        "model_id",
        "capabilities_version",
        "ui_contract_version",
        "renderer_fingerprint",
        "report_ref",
        "input_fingerprints",
        "recompute_endpoint"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "le-recalc-bindings-v1"
        },
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "model_id": {
          "type": "string",
          "enum": [
            "black-hole",
            "hit"
          ]
        },
        "capabilities_version": {
          "type": "string",
          "minLength": 1
        },
        "ui_contract_version": {
          "const": "le-player-report-ui-v1"
        },
        "renderer_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "report_ref": {
          "type": "object"
        },
        "input_fingerprints": {
          "type": "object",
          "required": [
            "calc_input",
            "ruleset",
            "snapshot",
            "dataset"
          ],
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "recompute_endpoint": {
          "type": "string",
          "pattern": "^http://(127\\.0\\.0\\.1|localhost|\\[::1\\]):[0-9]{1,5}/recompute$"
        }
      }
    },
    "profile_states": {
      "type": "object",
      "description": "顶层兼容副本（兼容旧读取方；与 capabilities.profile_states 相同）",
      "additionalProperties": {
        "type": "object"
      }
    }
  }
}
