{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "le-workflow/stage-cache-v1.json",
  "title": "P4 stage cache entry v1 (le-stage-cache-v1)",
  "description": "data/cache/pipeline/<stage_id>/<cache_key>.json；payload 副本在同目录 <cache_key>/output-*。命中前逐项校验 payload sha256；输出先 materialize 回当前 run 目录；无机器绝对路径。",
  "type": "object",
  "required": [
    "schema_version",
    "stage_id",
    "cache_key",
    "input_fingerprint",
    "implementation_fingerprint",
    "parameters_fingerprint",
    "dependencies",
    "outputs",
    "producer",
    "created_at"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "const": "le-stage-cache-v1"
    },
    "stage_id": {
      "type": "string",
      "minLength": 1
    },
    "cache_key": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "input_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "implementation_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "parameters_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "relative_path",
          "sha256",
          "bytes",
          "cached_path"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "relative_path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "cached_path": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "readiness": {
      "type": [
        "string",
        "null"
      ]
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "metrics": {
      "type": "object"
    },
    "producer": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "created_at": {
      "type": "string"
    }
  }
}
