  "reusable_conclusions": [
    {
      "text": "Black Hole（黑洞）· 本体 + 自然 Ignite 事件模型",
      "source": "$.title.zh"
    },
    {
      "text": "主技能 ability_id=bh2；职业=Mage；专精=Sorcerer；伤害标签=Fire、Cold、Spell、DoT、Ailment",
      "source": "$.ability_id/class/mastery/damage_tags"
    },
    {
      "text": "计算组件：bh-body-fire，kind=body，damage_type=fire，tags=Spell/DoT；Red Giant/Binary 条件下生成的火焰本体分量（RepeatedlyDamageEnemiesWithinRadius，hit=false、damageAtStart=true）；基础值/added scaling/interval 从 ruleset 读，不在模板中复制数值。",
      "source": "$.components[0]"
    },
    {
      "text": "计算组件：bh-body-cold，kind=body，damage_type=cold，tags=Spell/DoT；仅 Binary System 时存在的冷分量（第二颗星）；非 Binary 时不存在，Red Giant 下原冷伤被转换为火。",
      "source": "$.components[1]"
    },
    {
      "text": "计算组件：bh-ignite，kind=ignite，damage_type=fire，tags=DoT/Ailment；Heat Wave 施加的 Ignite（期望值模型）：单层伤害与期望层数分开计算；层数来自每次判定的期望值，不模拟逐次随机。",
      "source": "$.components[2]"
    },
    {
      "text": "计算块 tag_match → le_calc.damage.tags_match；组件标签适用性；Elemental 展开在标签匹配阶段完成。",
      "source": "$.calculation_blocks[0]"
    },
    {
      "text": "计算块 added_scaling → le_calc.damage.compute_body；每跳基础值 = base + added × addedDamageScaling；含 Red Giant/Binary 分量生成。",
      "source": "$.calculation_blocks[1]"
    },
    {
      "text": "计算块 increased_aggregate → le_calc.damage._collect_increased；inc 加算池（含 Intelligence 属性行）；Ignite 侧复用同一收集器。",
      "source": "$.calculation_blocks[2]"
    },
    {
      "text": "计算块 more_groups → le_calc.damage.group_more_rows；节点 more 分组（组内相加、组间相乘）；Ignite 继承集合由 ruleset.ignite.inheritance 决定。",
      "source": "$.calculation_blocks[3]"
    },
    {
      "text": "计算块 target_side → le_calc.damage._target_multiplier；抗性 - 穿透（可负）× (1 - monster_dr)；Ignite 侧镜像另读专属火穿。",
      "source": "$.calculation_blocks[4]"
    },
    {
      "text": "计算块 frequency → le_calc.cooldown.compute_cooldown；charge 基础/固定调整/CDR/ICR；施法时间由 compute_cast_time 单独计算。",
      "source": "$.calculation_blocks[5]"
    },
    {
      "text": "计算块 ledger → le_calc.ledger.build_source_ledger；来源账；规则账与一致性由 le_calc.report 生成。",
      "source": "$.calculation_blocks[6]"
    },
    {
      "text": "BH 本体组件与跳数离散化（ceil full ticks；生成即首跳）",
      "source": "$.supported_interactions[0]"
    },
    {
      "text": "Red Giant 冷转火（含 duration 加算）",
      "source": "$.supported_interactions[1]"
    },
    {
      "text": "Binary System 结构双分量 + 独立 more + Ignite 继承该 more",
      "source": "$.supported_interactions[2]"
    },
    {
      "text": "Singularity 单次施放 1 个黑洞；多次施放并存（eager 重叠、patient 等待）",
      "source": "$.supported_interactions[3]"
    },
    {
      "text": "Ignite 单层伤害、duration 乘区、Heat Wave 周期判定/期望层数/cohort 重叠与尾伤",
      "source": "$.supported_interactions[4]"
    },
    {
      "text": "Fire Penetration with Ignite（Ignite 专属）+ body/ignite 穿透分流",
      "source": "$.supported_interactions[5]"
    },
    {
      "text": "charge 冷却 / CDR / ICR / 施法时间 / eager-patient 循环与 5-30-120s 窗口",
      "source": "$.supported_interactions[6]"
    },
    {
      "text": "目标侧怪物等级 DR（1..100 表）与负抗性穿透",
      "source": "$.supported_interactions[7]"
    },
    {
      "text": "条件通道固定条件估算（注册效果的发现/求值/重算；见 docs/mechanisms.md §3.5 与条件注册表）",
      "source": "$.supported_interactions[8]"
    },
    {
      "text": "双基线 legacy_single_skill / build_base（不可混用或相减宣称增益）",
      "source": "$.supported_interactions[9]"
    },
    {
      "text": "来源账/规则账/一致性检查/离线单文件玩家报告与本地 serve 重算（BH 模型）",
      "source": "$.supported_interactions[10]"
    },
    {
      "text": "调度说明：charge-based + cast-time 双约束的事件调度；eager/patient 两种动作策略；单次口径观察至最后一层 Ignite 到期。目标/策略均为固定条件估算，不是实战 DPS。",
      "source": "$.schedule.notes"
    }
  ],
  "assumptions": [
    {
      "assumption_id": "bh-no-crit",
      "status": "confirmed",
      "note": "Black Hole 本体 hit=false、crit_chance=0、crit_multiplier=0；不引入暴击期望算子。",
      "source": "$.assumptions[0]"
    },
    {
      "assumption_id": "fixed-conditions-estimate",
      "status": "derived",
      "note": "条件效果按固定条件估算：选中状态在观察期保持，不模拟获得/维持成本；结果按 assumption 标注，不是实战 DPS。",
      "source": "$.assumptions[1]"
    },
    {
      "assumption_id": "ignite-expected-value",
      "status": "derived",
      "note": "Heat Wave 用期望层数（不是逐次随机事件）；要求判定相互独立，结果按数学期望解释。",
      "source": "$.assumptions[2]"
    },
    {
      "assumption_id": "ignite-scaling-pool",
      "status": "assumed",
      "note": "Ignite 玩家侧 inc 池构成（Fire/Elemental/DoT + Int 属性行）为规则包 assumed 口径。",
      "source": "$.assumptions[3]"
    },
    {
      "assumption_id": "ignite-damage-slices",
      "status": "assumed",
      "note": "Ignite 连续流积分 + 固定长度切片事件表的记账方式为 v1 实现假设；不改每层总伤害。",
      "source": "$.assumptions[4]"
    },
    {
      "assumption_id": "monster-dr-application",
      "status": "assumed",
      "note": "怪物 DR 作为目标侧独立乘区 ×(1-DR)、与抗性因子相乘的顺序未经游戏内单独验证。",
      "source": "$.assumptions[5]"
    },
    {
      "assumption_id": "cast-time-base-rate",
      "status": "assumed",
      "note": "施法时间公式形状已确认；基础释放速度（as × speedMultiplier）来自能力字段、未独立精确测量。",
      "source": "$.assumptions[6]"
    },
    {
      "assumption_id": "eager-patient-policies",
      "status": "assumed",
      "note": "eager/patient 是计算器的动作策略（充能/施法时间/黑洞存续期驱动），不是玩家实操序列。",
      "source": "$.assumptions[7]"
    },
    {
      "assumption_id": "target-theoretical-optimum",
      "status": "assumed",
      "note": "双星全覆盖 + 中心 1m 同时满足是理论最优，不代表真实轨道物理可达；目标不动不死。",
      "source": "$.assumptions[8]"
    },
    {
      "assumption_id": "build-base-definition",
      "status": "derived",
      "note": "build_base = legacy 基线 + 已确认具资格的常驻自动效果（当前为 Eternal Flames 被动）；两基线不可相减当作增益。",
      "source": "$.assumptions[9]"
    },
    {
      "assumption_id": "capabilities-not-landed",
      "status": "unresolved",
      "note": "capability_ref 是草案声明：P3R 要求的 report-capabilities.json（ui_contract_version/renderer_fingerprint/capabilities_digest/acceptance_refs）当前不存在；本模板不声称已落地。",
      "source": "$.assumptions[10]"
    }
  ],
