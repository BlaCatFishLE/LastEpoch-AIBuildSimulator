  "assumptions": [
    {
      "assumption_id": "fr-legacy-vs-build-base-ratio",
      "status": "derived",
      "note": "本案例/场景校验关系：legacy_single_skill 单次/DPS = build_base ÷ 1.49，差异机制为 Army of Skin 的 49% more melee 与 enemy_high_health 条件（legacy 关闭该状态）。这是本案例冻结政策下的校验关系，不是通用 legacy 换算规则；换 BD/场景必须重新推导。",
      "source": "$.assumptions[0]"
    },
    {
      "assumption_id": "fr-cooldown-icr-formula",
      "status": "assumed",
      "note": "Reflash 3s 冷却与 ICR 公式 (base+flat)/(1+ΣICR)；冷却从何时起算与 ICR 对充能的效果无 1.5.2 游戏真值（R13）。",
      "source": "$.assumptions[1]"
    },
    {
      "assumption_id": "fr-cooldown-limited-primary",
      "status": "assumed",
      "note": "基线 DPS 以 cooldown_limited 为主口径；attack_speed_limited 作为备选同时输出，政策变更须重锁 expected（policy_locked 语义）。",
      "source": "$.assumptions[2]"
    },
    {
      "assumption_id": "fr-enemy-high-health-default",
      "status": "assumed",
      "note": "Army of Skin 的 high/full health 默认成立（boss/rare 起手满血）；低于阈值时 49% more 失效，实战平均覆盖率未验证（R20）。",
      "source": "$.assumptions[3]"
    },
    {
      "assumption_id": "fr-ew-always-active",
      "status": "confirmed",
      "note": "Enchant Weapon 只要有近战命中就激活（Kindling Blade autoRecast）；legacy_single_skill 与 build_base 的 states 都把 EW active 设为 true，两基线实际差异只有 Army of Skin（scenario 注释存在漂移，需 Lead 复核）。",
      "source": "$.assumptions[4]"
    },
    {
      "assumption_id": "fr-rhythm-cycle-average",
      "status": "assumed",
      "note": "纯 FR 稳态循环每 4 次施放 1 次消耗 12 层（+130% more），DPS 用周期平均 ×1.325；其它技能补层与逐次离散不模拟（R18/R22/OQ8）。",
      "source": "$.assumptions[5]"
    },
    {
      "assumption_id": "fr-adaptive-added-as-fire",
      "status": "confirmed",
      "note": "无类型 added damage 是自适应伤害，本案例单 Fire 组件下按 Fire 结算（用户裁决）；每条 untyped added 行在 result assumptions 中留痕。",
      "source": "$.assumptions[6]"
    },
    {
      "assumption_id": "fr-typed-added-fire-only",
      "status": "assumed",
      "note": "fire_only 组件策略：非 Fire typed added 不转成 Fire、不建独立组件（R17）；会使非 Fire 伤害缺算（unsupported 已列）。",
      "source": "$.assumptions[7]"
    },
    {
      "assumption_id": "fr-crit-scaling-passives-normalized",
      "status": "assumed",
      "note": "Prodigy / Defender of Welryn 的 crit 贡献按快照归一值（added +0.01 / increased +0.08）计入；per-attribute 公式未验证（R25/OQ6）。",
      "source": "$.assumptions[8]"
    },
    {
      "assumption_id": "fr-target-resistance-zero",
      "status": "assumed",
      "note": "目标火抗默认 0；穿透为独立乘区 ×(1+Σpen)；负抗下限/区域惩罚不建模（R12）。",
      "source": "$.assumptions[9]"
    },
    {
      "assumption_id": "fr-mana-cost-estimate",
      "status": "assumed",
      "note": "Flame Reave mana 消耗为估算（base+flat 与 increased 顺序/符号 unresolved，OQ5）；只用于 mana_ge_300 与 ≥10 条件，不进入伤害数值。",
      "source": "$.assumptions[10]"
    },
    {
